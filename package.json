{
  "name": "react-native-ergometer-monorepo",
  "private": true,
  "description": "React Native library for fitness ergometers over Bluetooth Low Energy",
  "license": "MIT",
  "author": "Serhii Hryshko (https://github.com/sergey-g-s)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergey-g-s/react-native-ergometer.git"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "example": "pnpm --filter react-native-ergometer-example",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@react-native/eslint-config": "0.88.0",
    "eslint": "^9.39.5",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3"
  }
}
